<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Brand colors -->
    <Color x:Key="ColorBg">#F5F5F7</Color>
    <Color x:Key="ColorSurface">#FFFFFF</Color>
    <Color x:Key="ColorBorder">#E5E5EA</Color>

    <Color x:Key="ColorTextPrimary">#1C1C1E</Color>
    <Color x:Key="ColorTextSecondary">#8E8E93</Color>
    <Color x:Key="ColorTextCaption">#AEAEB2</Color>

    <Color x:Key="ColorAccent">#2563EB</Color>
    <Color x:Key="ColorAccentHover">#1D4ED8</Color>
    <Color x:Key="ColorAccentLight">#DBEAFE</Color>

    <Color x:Key="ColorFirstFit">#2563EB</Color>
    <Color x:Key="ColorBestFit">#D97706</Color>
    <Color x:Key="ColorWorstFit">#16A34A</Color>

    <!-- Brushes (định dạng lại thành SolidColorBrush) -->
    <SolidColorBrush x:Key="BrushBg"           Color="{StaticResource ColorBg}" />
    <SolidColorBrush x:Key="BrushSurface"      Color="{StaticResource ColorSurface}" />
    <SolidColorBrush x:Key="BrushBorder"       Color="{StaticResource ColorBorder}" />
    
    <SolidColorBrush x:Key="BrushTextPrimary"  Color="{StaticResource ColorTextPrimary}" />
    <SolidColorBrush x:Key="BrushTextSecondary" Color="{StaticResource ColorTextSecondary}" />
    <SolidColorBrush x:Key="BrushTextCaption" Color="{StaticResource ColorTextCaption}" />

    <SolidColorBrush x:Key="BrushAccent"       Color="{StaticResource ColorAccent}" />
    <SolidColorBrush x:Key="BrushAccentHover"       Color="{StaticResource ColorAccentHover}" />
    <SolidColorBrush x:Key="BrushAccentLight"       Color="{StaticResource ColorAccentLight}" />

    <SolidColorBrush x:Key="BrushFirstFit"       Color="{StaticResource ColorFirstFit}" />
    <SolidColorBrush x:Key="BrushBestFit"       Color="{StaticResource ColorBestFit}" />
    <SolidColorBrush x:Key="BrushWorstFit"       Color="{StaticResource ColorWorstFit}" />

</ResourceDictionary>