<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Card border -->
    <Style x:Key="CardBorder" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource BrushSurface}" />
        <Setter Property="BorderBrush" Value="{StaticResource BrushBorder}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{StaticResource RadiusSm}" />
        <Setter Property="Padding" Value="16" />
    </Style>


    <!-- Primary button -->
    <Style x:Key="BtnPrimary" TargetType="Button">
        <Setter Property="Background"
            Value="{StaticResource BrushAccent}" />
        <Setter Property="Foreground" Value="White" />
        <Setter Property="Padding" Value="8,4" />
        <Setter Property="Margin" Value="0,4,0,0" />
        <Setter Property="FontSize"
            Value="{StaticResource FontSizeBody}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Cursor" Value="Hand" />

        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background"
                    Value="{StaticResource BrushAccentHover}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- Secondary button -->
    <Style x:Key="BtnSecondary"
       TargetType="Button"
       BasedOn="{StaticResource BtnPrimary}">

        <Setter Property="Background"
            Value="{StaticResource BrushSurface}" />
        <Setter Property="Foreground"
            Value="{StaticResource BrushTextPrimary}" />
        <Setter Property="BorderBrush"
            Value="{StaticResource BrushBorder}" />
        <Setter Property="BorderThickness" Value="1" />

        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background"
                    Value="{StaticResource BrushAccentLight}" />
                <Setter Property="BorderBrush"
                    Value="{StaticResource BrushAccent}" />
            </Trigger>
        </Style.Triggers>
    </Style>



    <!-- TextBox style -->
    <Style x:Key="InputTextBox" TargetType="TextBox">
        <Setter Property="Background" Value="{StaticResource BrushSurface}" />
        <Setter Property="BorderBrush" Value="{StaticResource BrushBorder}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="4" />
    </Style>

    <!-- Tiêu đề từng phần -->
    <Style x:Key="SectionTitle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="18"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{StaticResource BrushTextPrimary}"/>
        <Setter Property="Margin" Value="0,0,0,16"/>
    </Style>

    <!-- Nhãn của từng trường nhập liệu -->
    <Style x:Key="FieldLabel" TargetType="TextBlock">
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="FontWeight" Value="Medium"/>
        <Setter Property="Foreground" Value="{StaticResource BrushTextSecondary}"/>
        <Setter Property="Margin" Value="0,0,0,6"/>
    </Style>
</ResourceDictionary>