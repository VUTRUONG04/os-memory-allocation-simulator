<UserControl x:Class="OSMemoryAllocationSimulator.Views.Evaluation.EvaluationView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:OSMemoryAllocationSimulator.ViewModels.Evaluation">
    <UserControl.DataContext>
        <vm:EvaluationViewModel/>
    </UserControl.DataContext>
    <UserControl.Resources>
        <!-- Mẫu 1 cột cho các biểu đồ 2, 3, 4 -->
        <DataTemplate x:Key="BarTemplate">
            <Grid Margin="0,3">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="90"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="90"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="{Binding Label}" VerticalAlignment="Center"/>
                <ProgressBar Grid.Column="1" Height="20" Minimum="0"
                             Maximum="{Binding Tag, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                             Value="{Binding Value, Mode=OneWay}"/>
                <TextBlock Grid.Column="2" Margin="8,0,0,0" VerticalAlignment="Center"
                           Text="{Binding Value, StringFormat={}{0:0.####}}"/>
            </Grid>
        </DataTemplate>

        <!-- Mẫu 2 cột (thành công xanh, thất bại đỏ) cho biểu đồ 1 -->
        <DataTemplate x:Key="AllocationBarTemplate">
            <Grid Margin="0,3">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="90"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="110"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <TextBlock Text="{Binding Label}" Grid.RowSpan="2" VerticalAlignment="Center"/>
                <ProgressBar Grid.Column="1" Height="14" Minimum="0" Foreground="SeaGreen"
                             Maximum="{Binding Tag, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                             Value="{Binding Value, Mode=OneWay}"/>
                <TextBlock Grid.Column="2" Margin="8,0,0,0" VerticalAlignment="Center"
                           Text="{Binding Value, StringFormat=Thành công: {0}}"/>
                <ProgressBar Grid.Column="1" Grid.Row="1" Height="14" Minimum="0" Margin="0,2,0,0" Foreground="Firebrick"
                             Maximum="{Binding Tag, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                             Value="{Binding Value2, Mode=OneWay}"/>
                <TextBlock Grid.Column="2" Grid.Row="1" Margin="8,2,0,0" VerticalAlignment="Center"
                           Text="{Binding Value2, StringFormat=Thất bại: {0}}"/>
            </Grid>
        </DataTemplate>
    </UserControl.Resources>
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="20">
            <TextBlock Text="ĐÁNH GIÁ THUẬT TOÁN CẤP PHÁT BỘ NHỚ"
                       FontSize="20"
                       FontWeight="Bold"
                       Margin="0,0,0,14"/>
            <StackPanel Orientation="Horizontal"
                        Margin="0,0,0,12">
                <Button Content="Chạy đánh giá"
                        Command="{Binding RunEvaluationCommand}"
                        Padding="16,8"
                        Margin="0,0,8,0"/>
                <Button Content="Xuất CSV so sánh"
                        Command="{Binding ExportComparisonCommand}"
                        Padding="16,8"/>
            </StackPanel>
            <TextBlock Text="{Binding EvaluationComment}"
                       TextWrapping="Wrap"
                       Margin="0,0,0,14"/>
            <TextBlock Text="Bảng so sánh"
                       FontSize="16"
                       FontWeight="SemiBold"/>
            <DataGrid ItemsSource="{Binding ComparisonResults}"
                      AutoGenerateColumns="False"
                      IsReadOnly="True"
                      CanUserAddRows="False"
                      Margin="0,8,0,18">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Thuật toán" Binding="{Binding AlgorithmName}"/>
                    <DataGridTextColumn Header="Tổng yêu cầu" Binding="{Binding TotalAllocateRequests}"/>
                    <DataGridTextColumn Header="Thành công" Binding="{Binding SuccessCount}"/>
                    <DataGridTextColumn Header="Thất bại" Binding="{Binding FailureCount}"/>
                    <DataGridTextColumn Header="Tỷ lệ thành công (%)" Binding="{Binding SuccessRate, StringFormat=F2}"/>
                    <DataGridTextColumn Header="Run 1 (ms)" Binding="{Binding RuntimeRun1Ms}"/>
                    <DataGridTextColumn Header="Run 2 (ms)" Binding="{Binding RuntimeRun2Ms}"/>
                    <DataGridTextColumn Header="Run 3 (ms)" Binding="{Binding RuntimeRun3Ms}"/>
                    <DataGridTextColumn Header="Run 4 (ms)" Binding="{Binding RuntimeRun4Ms}"/>
                    <DataGridTextColumn Header="Run 5 (ms)" Binding="{Binding RuntimeRun5Ms}"/>
                    <DataGridTextColumn Header="TB (ms)" Binding="{Binding AverageRuntimeMs, StringFormat=F4}"/>
                    <DataGridTextColumn Header="Phân mảnh nội bộ" Binding="{Binding TotalInternalFragmentation}"/>
                    <DataGridTextColumn Header="Vùng trống lớn nhất" Binding="{Binding LargestFreeBlock}"/>
                </DataGrid.Columns>
            </DataGrid>

            <TextBlock Text="Biểu đồ so sánh"
                       FontSize="16"
                       FontWeight="SemiBold"/>
            <TextBlock Text="1. Cấp phát thành công / thất bại" FontWeight="SemiBold" Margin="0,10,0,2"/>
            <ItemsControl ItemsSource="{Binding AllocationChart}"
                          Tag="{Binding AllocationMax}"
                          ItemTemplate="{StaticResource AllocationBarTemplate}"/>

            <TextBlock Text="2. Phân mảnh nội bộ" FontWeight="SemiBold" Margin="0,10,0,2"/>
            <ItemsControl ItemsSource="{Binding FragmentationChart}"
                          Tag="{Binding FragmentationMax}"
                          ItemTemplate="{StaticResource BarTemplate}"/>

            <TextBlock Text="3. Vùng trống lớn nhất" FontWeight="SemiBold" Margin="0,10,0,2"/>
            <ItemsControl ItemsSource="{Binding LargestFreeBlockChart}"
                          Tag="{Binding LargestFreeBlockMax}"
                          ItemTemplate="{StaticResource BarTemplate}"/>

            <TextBlock Text="4. Thời gian chạy trung bình (ms)" FontWeight="SemiBold" Margin="0,10,0,2"/>
            <ItemsControl ItemsSource="{Binding RuntimeChart}"
                          Tag="{Binding RuntimeMax}"
                          ItemTemplate="{StaticResource BarTemplate}"/>
        </StackPanel>
    </ScrollViewer>
</UserControl>