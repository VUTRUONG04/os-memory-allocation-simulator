<UserControl x:Class="OSMemoryAllocationSimulator.Views.Evaluation.EvaluationView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:OSMemoryAllocationSimulator.Views.Evaluation"
             mc:Ignorable="d"
             d:DesignHeight="450" d:DesignWidth="800"
             Background="{StaticResource BrushBg}">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="32">

            <!-- Screen header -->
            <TextBlock Text="Cấu hình đánh giá"
                       FontSize="{StaticResource FontSizeTitle}"
                       FontWeight="Bold"
                       Foreground="{StaticResource BrushTextPrimary}" />

            <TextBlock Text="Thiết lập bộ nhớ và workload trước khi chạy đánh giá."
                       Margin="0,8,0,24"
                       Foreground="{StaticResource BrushTextSecondary}" />

            <!-- Configuration sections -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- Card 1: Cấu hình bộ nhớ -->
                <Border Grid.Column="0"
                        Style="{StaticResource CardBorder}">
                    <TextBlock Text="Cấu hình bộ nhớ"
                               Margin="12"
                               VerticalAlignment="Center"
                               HorizontalAlignment="Center"
                               Foreground="{StaticResource BrushTextPrimary}" />
                </Border>

                <!-- Card 2: Chọn workload -->
                <Border Grid.Column="1"
                        Style="{StaticResource CardBorder}"
                        Margin="12,0,0,0">
                    <TextBlock Text="Chọn workload"
                               Margin="12"
                               VerticalAlignment="Center"
                               HorizontalAlignment="Center"
                               Foreground="{StaticResource BrushTextPrimary}" />
                </Border>

                <!-- Card 3: Khởi chạy đánh giá -->
                <Border Grid.Column="2"
                        Style="{StaticResource CardBorder}"
                        Margin="12,0,0,0">
                    <TextBlock Text="Khởi chạy đánh giá"
                               Margin="12"
                               VerticalAlignment="Center"
                               HorizontalAlignment="Center"
                               Foreground="{StaticResource BrushTextPrimary}" />
                </Border>
            </Grid>

        </StackPanel>
    </ScrollViewer>
</UserControl>