<UserControl x:Class="OSMemoryAllocationSimulator.Views.Simulation.SimulationConfigView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:OSMemoryAllocationSimulator.ViewModels"
             Background="{StaticResource BrushBg}">

    <UserControl.DataContext>
        <vm:SimulationConfigViewModel/>
    </UserControl.DataContext>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="24">

            <!-- HEADER -->
            <TextBlock Text="Mô phỏng cấp phát bộ nhớ"
                       FontSize="26"
                       FontWeight="Bold"
                       Foreground="{StaticResource BrushTextPrimary}"/>

            <TextBlock Text="Cấu hình và theo dõi quá trình cấp phát bộ nhớ."
                       Margin="0,8,0,20"
                       Foreground="{StaticResource BrushTextSecondary}"/>

            <!-- 1. CONFIGURATION -->
            <Border Style="{StaticResource CardBorder}"
                    Padding="16"
                    Margin="0,0,0,16">

                <StackPanel>
                    <TextBlock Text="1. Cấu hình mô phỏng"
                               FontSize="18"
                               FontWeight="Bold"
                               Margin="0,0,0,12"/>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0"
                                    Margin="4">
                            <TextBlock Text="MemorySize (KB)"
                                       Margin="0,0,0,6"/>

                            <TextBox Text="{Binding MemorySize,
                                                    Mode=TwoWay,
                                                    UpdateSourceTrigger=PropertyChanged}"
                                     Style="{StaticResource InputTextBox}"/>
                        </StackPanel>

                        <StackPanel Grid.Column="1"
                                    Margin="4">
                            <TextBlock Text="AllocationUnit (KB)"
                                       Margin="0,0,0,6"/>

                            <TextBox Text="{Binding AllocationUnit,
                                                    Mode=TwoWay,
                                                    UpdateSourceTrigger=PropertyChanged}"
                                     Style="{StaticResource InputTextBox}"/>
                        </StackPanel>

                        <StackPanel Grid.Column="2"
                                    Margin="4">
                            <TextBlock Text="Thuật toán"
                                       Margin="0,0,0,6"/>

                            <ComboBox ItemsSource="{Binding AlgorithmOptions}"
                                      SelectedItem="{Binding SelectedAlgorithm,
                                                             Mode=TwoWay}"
                                      Padding="6"/>
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- 2. WORKLOAD CONFIGURATION -->
            <Border Style="{StaticResource CardBorder}"
                    Padding="16"
                    Margin="0,0,0,16">

                <StackPanel>
                    <TextBlock Text="2. Cấu hình Workload"
                               FontSize="18"
                               FontWeight="Bold"
                               Margin="0,0,0,12"/>

                    <TextBlock Text="Chọn nguồn dữ liệu đầu vào"
                               Style="{StaticResource FieldLabel}"/>

                    <WrapPanel Margin="0,8,0,12">

                        <Button Content="Sử dụng dữ liệu mẫu"
                                Command="{Binding LoadPresetCommand}"
                                Padding="14,8"
                                Margin="4"/>

                        <Button Content="Chọn file CSV"
                                Command="{Binding BrowseAndLoadCsvCommand}"
                                Padding="14,8"
                                Margin="4"/>

                    </WrapPanel>

                    <TextBlock Text="Đường dẫn file CSV"
                               Style="{StaticResource FieldLabel}"/>

                    <TextBox Text="{Binding CsvFilePath, Mode=OneWay}"
                             IsReadOnly="True"
                             Style="{StaticResource InputTextBox}"
                             Margin="0,6,0,8"/>

                    <TextBlock Text="Có thể sử dụng workload mẫu hoặc nạp dữ liệu từ file CSV."
                               TextWrapping="Wrap"
                               Foreground="{StaticResource BrushTextSecondary}"/>

                </StackPanel>
            </Border>

            <!-- 3. SIMULATION CONTROLS -->
            <Border Style="{StaticResource CardBorder}"
                    Padding="16"
                    Margin="0,0,0,16">

                <StackPanel>
                    <TextBlock Text="3. Điều khiển mô phỏng"
                               FontSize="18"
                               FontWeight="Bold"
                               Margin="0,0,0,12"/>

                    <WrapPanel>
                        <Button Content="Start Simulation"
                                Command="{Binding StartSimulationCommand}"
                                Padding="16,8"
                                Margin="4"/>

                        <Button Content="Run"
                                Command="{Binding RunCommand}"
                                Padding="16,8"
                                Margin="4"/>

                        <Button Content="Pause"
                                Command="{Binding PauseCommand}"
                                Padding="16,8"
                                Margin="4"/>

                        <Button Content="Step"
                                Command="{Binding StepCommand}"
                                Padding="16,8"
                                Margin="4"/>

                        <Button Content="Reset"
                                Command="{Binding ResetCommand}"
                                Padding="16,8"
                                Margin="4"/>
                    </WrapPanel>

                    <TextBlock Text="{Binding StatusMessage}"
                               Margin="4,12,4,0"
                               TextWrapping="Wrap"
                               Foreground="{StaticResource BrushTextPrimary}"/>
                </StackPanel>
            </Border>


            <!-- 4. MEMORY STATISTICS -->
            <Border Style="{StaticResource CardBorder}"
                    Padding="16"
                    Margin="0,0,0,16">

                <StackPanel>
                    <TextBlock Text="4. Memory Statistics"
                               FontSize="18"
                               FontWeight="Bold"
                               Margin="0,0,0,16"/>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- USED MEMORY -->
                        <StackPanel Grid.Row="0"
                                    Grid.Column="0"
                                    Margin="6">
                            <TextBlock Text="Used Memory"
                                       Foreground="{StaticResource BrushTextSecondary}"/>

                            <TextBlock Text="{Binding UsedMemory, StringFormat={}{0} KB}"
                                       FontSize="22"
                                       FontWeight="Bold"
                                       Margin="0,6,0,0"/>
                        </StackPanel>

                        <!-- FREE MEMORY -->
                        <StackPanel Grid.Row="0"
                                    Grid.Column="1"
                                    Margin="6">
                            <TextBlock Text="Free Memory"
                                       Foreground="{StaticResource BrushTextSecondary}"/>

                            <TextBlock Text="{Binding FreeMemory, StringFormat={}{0} KB}"
                                       FontSize="22"
                                       FontWeight="Bold"
                                       Margin="0,6,0,0"/>
                        </StackPanel>

                        <!-- FREE BLOCK COUNT -->
                        <StackPanel Grid.Row="0"
                                    Grid.Column="2"
                                    Margin="6">
                            <TextBlock Text="Free Blocks"
                                       Foreground="{StaticResource BrushTextSecondary}"/>

                            <TextBlock Text="{Binding FreeBlockCount}"
                                       FontSize="22"
                                       FontWeight="Bold"
                                       Margin="0,6,0,0"/>
                        </StackPanel>

                        <!-- LARGEST FREE BLOCK -->
                        <StackPanel Grid.Row="1"
                                    Grid.Column="0"
                                    Margin="6,18,6,6">
                            <TextBlock Text="Largest Free Block"
                                       Foreground="{StaticResource BrushTextSecondary}"/>

                            <TextBlock Text="{Binding LargestFreeBlock, StringFormat={}{0} KB}"
                                       FontSize="22"
                                       FontWeight="Bold"
                                       Margin="0,6,0,0"/>
                        </StackPanel>

                        <!-- INTERNAL FRAGMENTATION -->
                        <StackPanel Grid.Row="1"
                                    Grid.Column="1"
                                    Margin="6,18,6,6">
                            <TextBlock Text="Internal Fragmentation"
                                       Foreground="{StaticResource BrushTextSecondary}"/>

                            <TextBlock Text="{Binding TotalInternalFragmentation, StringFormat={}{0} KB}"
                                       FontSize="22"
                                       FontWeight="Bold"
                                       Margin="0,6,0,0"/>
                        </StackPanel>

                        <!-- MEMORY USAGE -->
                        <StackPanel Grid.Row="1"
                                    Grid.Column="2"
                                    Margin="6,18,6,6">
                            <TextBlock Text="Memory Usage"
                                       Foreground="{StaticResource BrushTextSecondary}"/>

                            <TextBlock Text="{Binding MemoryUsagePercentage, StringFormat={}{0:F2}%}"
                                       FontSize="22"
                                       FontWeight="Bold"
                                       Margin="0,6,0,0"/>
                        </StackPanel>
                    </Grid>

                    <ProgressBar Value="{Binding MemoryUsagePercentage}"
                                 Maximum="100"
                                 Height="12"
                                 Margin="6,18,6,0"/>

                </StackPanel>
            </Border>

            <!-- 5. MEMORY MAP -->

            <Border Style="{StaticResource CardBorder}"
                    Padding="16"
                    Margin="0,0,0,16">

                <StackPanel>
                    <TextBlock Text="4. Memory Map"
                               FontSize="18"
                               FontWeight="Bold"
                               Margin="0,0,0,12"/>

                    <DataGrid ItemsSource="{Binding MemoryMap}"
                              AutoGenerateColumns="False"
                              IsReadOnly="True"
                              CanUserAddRows="False"
                              MinHeight="150">

                        <DataGrid.Columns>

                            <DataGridTextColumn Header="Start Address"
                                                Binding="{Binding StartAddress}"
                                                Width="*"/>

                            <DataGridTextColumn Header="Size (KB)"
                                                Binding="{Binding Size}"
                                                Width="*"/>

                            <DataGridTextColumn Header="Is Free"
                                                Binding="{Binding IsFree}"
                                                Width="*"/>

                            <DataGridTextColumn Header="Process ID"
                                                Binding="{Binding ProcessId}"
                                                Width="*"/>

                            <DataGridTextColumn Header="Requested Size"
                                                Binding="{Binding RequestedSize}"
                                                Width="*"/>

                        </DataGrid.Columns>
                    </DataGrid>
                </StackPanel>
            </Border>

            <!-- 5. OPERATION TRACE -->
            <Border Style="{StaticResource CardBorder}"
                    Padding="16">

                <StackPanel>
                    <TextBlock Text="5. Operation Trace"
                               FontSize="18"
                               FontWeight="Bold"
                               Margin="0,0,0,12"/>

                    <DataGrid ItemsSource="{Binding TraceEntries}"
                              AutoGenerateColumns="False"
                              IsReadOnly="True"
                              CanUserAddRows="False"
                              MinHeight="180">

                        <DataGrid.Columns>

                            <DataGridTextColumn Header="Sequence"
                                                Binding="{Binding Sequence}"
                                                Width="70"/>

                            <DataGridTextColumn Header="Operation"
                                                Binding="{Binding Operation}"
                                                Width="*"/>

                            <DataGridTextColumn Header="Process"
                                                Binding="{Binding ProcessId}"
                                                Width="*"/>

                            <DataGridTextColumn Header="Requested"
                                                Binding="{Binding RequestedSize}"
                                                Width="*"/>

                            <DataGridTextColumn Header="Allocated"
                                                Binding="{Binding AllocatedSize}"
                                                Width="*"/>

                            <DataGridTextColumn Header="Status"
                                                Binding="{Binding Status}"
                                                Width="*"/>

                            <DataGridTextColumn Header="Reason"
                                                Binding="{Binding Reason}"
                                                Width="2*"/>

                        </DataGrid.Columns>
                    </DataGrid>
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</UserControl>
