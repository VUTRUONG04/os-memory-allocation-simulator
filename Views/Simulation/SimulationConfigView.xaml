<UserControl x:Class="OSMemoryAllocationSimulator.Views.Simulation.SimulationConfigView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:OSMemoryAllocationSimulator.ViewModels"
             Background="{StaticResource BrushBg}">

    <UserControl.DataContext>
        <vm:SimulationConfigViewModel/>
    </UserControl.DataContext>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="32">

            <!-- Screen header -->
            <TextBlock Text="Cấu hình mô phỏng"
                       FontSize="{StaticResource FontSizeTitle}"
                       FontWeight="Bold"
                       Foreground="{StaticResource BrushTextPrimary}" />

            <TextBlock Text="Thiết lập bộ nhớ và workload trước khi bắt đầu."
                       Margin="0,8,0,24"
                       Foreground="{StaticResource BrushTextSecondary}" />

            <!-- Configuration sections -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Style="{StaticResource CardBorder}">
                    <StackPanel Margin="12">
                        <TextBlock Style="{StaticResource SectionTitle}"
                                   Text="1. Cấu hình bộ nhớ"/>
                        <TextBlock Style="{StaticResource FieldLabel}"
                                   Text="MemorySize (KB)"/>
                        <TextBox x:Name="TxtMemorySize"
                                 Style="{StaticResource InputTextBox}"
                                 Text="{Binding MemorySize, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 />
                    </StackPanel>
                </Border>

                <Border Grid.Column="1"
                        Style="{StaticResource CardBorder}"
                        Margin="12,0,0,0">
                    <TextBlock Text="Chọn workload" />
                </Border>

                <Border Grid.Column="2"
                        Style="{StaticResource CardBorder}"
                        Margin="12,0,0,0">
                    <TextBlock Text="Khởi chạy mô phỏng" />
                </Border>
            </Grid>

        </StackPanel>
    </ScrollViewer>
</UserControl>
